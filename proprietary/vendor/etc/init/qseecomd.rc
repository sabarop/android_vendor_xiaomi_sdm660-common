on init
    wait /dev/qseecom
    start vendor.qseecomd

on property:vendor.keymaster.quickboot=true
   stop vendor.qseecomd
   start vendor.qseecomd

service vendor.qseecomd /vendor/bin/qseecomd
    class core
    user root
    group root
